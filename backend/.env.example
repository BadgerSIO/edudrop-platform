NODE_ENV=development
PORT=5000
DATABASE_URL=mongodb://127.0.0.1:27017/edudrop
BCRYPT_SALT=10
JWT_SECRET=change-me
FRONTEND=http://localhost:3000
# Portfolio Demo Protection
# Defaults to false when NODE_ENV!=production, and true when NODE_ENV=production.
# Set explicitly to "true" or "false" to override.
# DEMO_MODE=true
DEMO_RESET_INTERVAL_MINUTES=30
# Optional private passkey allowing the site owner to unlock full CRUD in Demo Mode
OWNER_BYPASS_KEY=
# Optional. Leave SMTP_HOST empty to log emails instead of sending them.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@edudrop.org
